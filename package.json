    "@mantine/dates": "^9.4.2",
    "@mantine/form": "^9.4.2",
    "@mantine/hooks": "^9.4.2",
    "@mantine/modals": "^9.4.2",
    "@mantine/notifications": "^9.4.2",
    "@tabler/icons-react": "^3.45.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "dayjs": "^1.11.21",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.11.0",
